(file
  (for 2:1 i (..= 1 15)
(if 3:5 (== (% i 15) 0)
(expr (call (. sys print) "fizzbuzz"))

      (elif (== (% i 3) 0)
(expr (call (. sys print) "fizz"))
      )
      (elif (== (% i 5) 0)
(expr (call (. sys print) "buzz"))
      )
      (else
(expr (call (. sys print) (str i)))
      )
    )

  )
)
